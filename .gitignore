# Runtime/state files that shouldn't be version-controlled
herdr/.config/herdr/*.sock
herdr/.config/herdr/*.log
herdr/.config/herdr/session.json
herdr/.config/herdr/release-notes.json
herdr/.config/herdr/.plugins.lock

# Editor/backup cruft
*.bak
*.bak.*

# Omarchy-managed live theme symlinks (regenerated per-machine by
# omarchy-theme-set / /usr/share/omarchy/install/user/theme.sh) -
# not portable, must not be tracked.
nvim/.config/nvim/lua/plugins/theme.lua
btop/.config/btop/themes/current.theme
