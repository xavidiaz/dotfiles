{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "margin": 2 },
  "paragraph": {},
  "text": {},
  "heading": { "block_suffix": "\n", "bold": true },
  "h1": { "prefix": "█ ", "color": "4" },
  "h2": { "prefix": "▌ ", "color": "5" },
  "h3": { "prefix": "▎ ", "color": "6" },
  "h4": { "prefix": "▏ ", "color": "2" },
  "h5": { "prefix": "▏ ", "color": "2" },
  "h6": { "prefix": "▏ ", "color": "8" },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "8", "italic": true },
  "list": { "level_indent": 2 },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "strong": { "bold": true },
  "emph": { "italic": true },
  "strikethrough": { "crossed_out": true },
  "hr": { "color": "8", "format": "\n──────────\n" },
  "link": { "color": "4", "underline": true },
  "link_text": { "color": "4", "bold": true },
  "image": { "color": "4", "underline": true },
  "image_text": { "color": "8", "format": "Image: {{.text}} →" },
  "code": { "color": "5" },
  "code_block": { "color": "6", "margin": 2 },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
