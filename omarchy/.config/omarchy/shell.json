{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "io.github.twiking.omasettings"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "xavidiaz.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "yyyy-MM-dd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "weekStartDay": "monday"
        },
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Stockholm",
              "zone": "Europe/Stockholm"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            }
          ]
        },
        {
          "id": "omarchy.weather"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "io.github.oidium.pocket-extended"
        },
        {
          "id": "gexavi.peripheral-battery"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "centerBegin": [],
      "centerEnd": [],
      "tray": [
        {
          "id": "jebin2.read-aloud"
        },
        {
          "id": "omaplug"
        },
        {
          "id": "io.github.ilyazar.syncthing"
        },
        {
          "id": "furmware.cloud"
        },
        {
          "id": "hass"
        },
        {
          "id": "mkelk.keepass-picker"
        },
        {
          "id": "mehiel.darky"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "bramvanoploo.omarchy-t2-linux"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.tailscale"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "expose.window-overview",
      "hotCornerEnabled": false
    },
    {
      "id": "xavidiaz.bar-edge"
    },
    {
      "id": "io.voxtype.settings"
    }
  ],
  "disabledPlugins": [
    "omarchy.reminders"
  ]
}
