{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "io.github.twiking.omasettings"
        },
        {
          "id": "xavidiaz.workspaces"
        },
        {
          "id": "omarchy.agents"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "yyyy-MM-dd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "weekStartDay": "monday"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "io.github.oidium.pocket-extended"
        },
        {
          "id": "io.github.ilyazar.syncthing"
        },
        {
          "id": "omaplug"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "mkelk.keepass-picker"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "bramvanoploo.omarchy-t2-linux"
        },
        {
          "id": "furmware.cloud"
        },
        {
          "id": "hass"
        },
        {
          "id": "mehiel.darky"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "crmne.hyprmoncfg"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "expose.window-overview",
      "hotCornerEnabled": false
    }
  ],
  "disabledPlugins": [
    "omarchy.reminders"
  ]
}
