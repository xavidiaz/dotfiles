{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "io.github.twiking.omasettings"
        },
        {
          "id": "io.github.thetrueferret.decent-workspaces"
        },
        {
          "id": "omarchy.agents"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "io.github.ilyazar.syncthing"
        },
        {
          "id": "omaplug"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "mehiel.darky"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omarchy.monitor"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "expose.window-overview"
    }
  ]
}
